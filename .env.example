# Hosting hands out one URL instead of five variables. Set this and the five below are
# ignored; server/db.js turns on TLS for it automatically.
# DATABASE_URL=

# Behind a TLS-terminating proxy (Render, Fly, a reverse proxy) the socket inside the
# container is plain HTTP, so x-forwarded-proto is the only signal that the visitor arrived
# over HTTPS. Set this there, and never on a machine that is directly reachable.
# TRUST_PROXY=1

CORE_DB_USER=path2uni
CORE_DB_PASSWORD=change_me_core
CORE_DB_NAME=path2uni_core
# 5432 is often taken by a local Postgres.
CORE_DB_PORT=5442

# Production (Render + Supabase/Neon): use the provider's PostgreSQL connection URL.
# When set, this takes precedence over the CORE_DB_* values above.
DATABASE_URL=

INTEL_DB_USER=path2uni_ai
INTEL_DB_PASSWORD=change_me_intel
INTEL_DB_NAME=path2uni_intelligence
INTEL_DB_PORT=5433


# Server-side only. No VITE_ prefix, so Vite never bundles it into the browser.
GEMINI_API_KEY=

# Field-encryption keys — generate your own with: npm run keygen
P2U_KEYS=
P2U_INDEX_KEY=

# Mail. Without these the app works exactly as before: codes are not sent, the second factor
# cannot be turned on, and no reminders go out. Nothing breaks.
# Gmail needs an App Password (Google account → 2-Step Verification → App passwords),
# not the account password. Keep it out of git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=path2uni.edu@gmail.com
SMTP_PASS=
MAIL_FROM=Path2Uni <path2uni.edu@gmail.com>
